# Root allowlist: application code/assets and approved project documents only.
/*
!/.gitignore
!/.agents/
!/.agent/
!/PRD.md
!/subject.md
!/README.md
!/CONTRIBUTING.md
!/.github/
!/docs/
!/assets/
!/frontend/
!/backend/
!/Dockerfile
!/.dockerignore
!/render.yaml

# Only application inputs/configuration are allowed within each app.
/frontend/*
!/frontend/src/
!/frontend/public/
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/index.html
!/frontend/tsconfig*.json
!/frontend/vite.config.*
!/frontend/.oxlintrc.json
!/frontend/.env.example
!/frontend/tests/
!/frontend/playwright.config.*

/backend/*
!/backend/src/
!/backend/prisma/
!/backend/test/
!/backend/scripts/
!/backend/package.json
!/backend/package-lock.json
!/backend/tsconfig*.json
!/backend/nest-cli.json
!/backend/.env.example

# Dependencies, generated output, caches and local configuration at any depth.
**/node_modules/
**/dist/
**/build/
**/coverage/
**/.vite/
**/.cache/
**/__pycache__/
*.pyc
*.tsbuildinfo
*.log
**/.env
**/.env.*
!**/.env.example
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
*.pem
*.key
*.pfx
